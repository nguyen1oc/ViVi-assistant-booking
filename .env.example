# ==============================================================================
# VinFast Booking Agent — Environment Configuration (.env.example)
# Sao chép file này thành .env rồi điền giá trị thực tế vào.
# TUYỆT ĐỐI KHÔNG commit file .env lên git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APP & NETWORK SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="AI20K Agent"
APP_ENV=development                        # Options: development, production, test
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO                             # Options: DEBUG, INFO, WARNING, ERROR
CORS_ORIGINS=http://localhost:3000,http://localhost:3100
PUBLIC_SITE_URL=http://localhost:3000

# Bật chế độ demo nổi (Floating Demo); tắt ở production nếu không cần.
FLOATING_DEMO_ENABLED=true

# ------------------------------------------------------------------------------
# 2. LLM / AI CONFIGURATION
# ------------------------------------------------------------------------------
# Khóa API bắt buộc để trợ lý ViVi hoạt động. Dùng một trong hai provider:
OPENAI_API_KEY=<your-openai-api-key>
OPENROUTER_API_KEY=<your-openrouter-api-key>

# Mô hình chính dùng cho trợ lý ViVi (gpt-5.6-luna, gpt-4o, deepseek/... tuỳ túi tiền)
MODEL_NAME=gpt-5.6-luna
# Mô hình nhỏ hơn chuyên phân loại ý định câu hỏi trước khi vào trợ lý chính
CLASSIFIER_MODEL_NAME=gpt-4o-mini

LLM_TEMPERATURE=0.7
LLM_REASONING_EFFORT=low                   # Options: none, low, medium, high, xhigh, max
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# Ngân sách chi phí LLM hàng ngày (tắt khi test local để không bị chặn giữa chừng)
LLM_DAILY_BUDGET_ENABLED=true
LLM_DAILY_MAX_COST_USD=20.0
LLM_SESSION_MAX_COST_USD_PER_DAY=1.0
LLM_MAX_CALLS_PER_TURN=8
# Giá ước tính để tính ngân sách (USD per 1M tokens)
LLM_ESTIMATED_INPUT_TOKEN_PRICE_PER_1M=0.15
LLM_ESTIMATED_OUTPUT_TOKEN_PRICE_PER_1M=0.60
LLM_ESTIMATED_OUTPUT_TOKENS_PER_CALL=700

# ------------------------------------------------------------------------------
# 3. DATABASE & STORAGE (PostgreSQL, Redis, Media CDN)
# ------------------------------------------------------------------------------
# Docker Compose: dùng giá trị mặc định bên dưới (PostgreSQL container nội bộ)
# Production / Neon: thay bằng chuỗi kết nối đám mây thực tế
DATABASE_URL=postgresql://vinfast:vinfast@localhost:5432/vinfast_booking

REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# Seed Data: nạp dữ liệu mẫu vào database rỗng lần đầu khởi chạy
AUTO_LOAD_EVAL_DATA=true
# Đường dẫn thư mục chứa các file CSV đã tải từ Google Drive
EVAL_DATA_DIR=eval/datav2/data-final-v2
BOOKING_ADVANCE_WINDOW_DAYS=30

# Media CDN cho hình ảnh xe VinFast
MEDIA_ROOT=./data/media
MEDIA_BASE_URL=https://media.example.com

# Vector Store (tùy chọn — dùng Chroma local khi phát triển)
CHROMA_PERSIST_DIR=./data/chroma

# ------------------------------------------------------------------------------
# 4. SECURITY & SESSION SECRETS (Bắt buộc >= 32 ký tự trên production)
# ------------------------------------------------------------------------------
BOOKING_ACCESS_OTP_SECRET=replace-with-a-random-secret-at-least-32-chars
CONVERSATION_SIGNING_SECRET=replace-with-another-random-secret-32-chars

# Cấu hình OTP
BOOKING_ACCESS_OTP_TTL_SECONDS=300         # Hiệu lực 5 phút
BOOKING_ACCESS_OTP_RESEND_COOLDOWN_SECONDS=60
BOOKING_ACCESS_OTP_MAX_ATTEMPTS=3
INTERNAL_SESSION_TTL_SECONDS=28800         # Phiên nhân viên nội bộ: 8 giờ

# ------------------------------------------------------------------------------
# 5. GUARDRAILS & RATE LIMITING
# ------------------------------------------------------------------------------
# Bật bộ kiểm soát đầu vào/đầu ra an toàn; chỉ tắt khi debug nhanh ở local
GUARDRAILS_ENABLED=true
GUARDRAILS_MAX_PAYLOAD_BYTES=16384
GUARDRAILS_MAX_PAYLOAD_DEPTH=6
GUARDRAILS_MAX_PAYLOAD_NODES=256
GUARDRAILS_MAX_PAYLOAD_STRING_CHARS=5000
GUARDRAILS_MAX_TOOL_CALLS_PER_MESSAGE=3
GUARDRAILS_MAX_OUTPUT_CHARS=8000

RATE_LIMIT_ENABLED=true
LLM_DAILY_BUDGET_ENABLED=true

# ------------------------------------------------------------------------------
# 6. LANGSMITH — Theo dõi luồng hội thoại AI (Tùy chọn)
# ------------------------------------------------------------------------------
# Bật LANGSMITH_TRACING=true để xem toàn bộ bước xử lý AI trên bảng LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=vinfast-test-drive
LANGSMITH_EVENT_LOGS=false
# Alias cũ — giữ lại để tương thích với một số phiên bản LangChain
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=vinfast-test-drive
LANGCHAIN_TRACING_V2=false

# ------------------------------------------------------------------------------
# 7. NOTIFICATION — Gửi thông báo Email & Zalo
# ------------------------------------------------------------------------------
# Gmail OAuth2 (tắt khi chạy thử local)
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER_EMAIL=""
GMAIL_SENDER_NAME="VinFast"
GMAIL_TIMEOUT_SECONDS=15

# Tiến trình gửi thông báo nền
NOTIFICATION_POLL_INTERVAL_SECONDS=60      # Giảm xuống 5 khi test local
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=30

# Zalo Bot (tùy chọn — chỉ bật sau khi webhook Zalo đã được cấu hình)
ZALO_BOT_ENABLED=false
ZALO_BOT_TOKEN=""
ZALO_BOT_WEBHOOK_SECRET=replace-with-a-long-random-secret
ZALO_BOT_API_BASE_URL=https://bot-api.zaloplatforms.com
ZALO_BOT_POLLING_ENABLED=false             # Chỉ dùng khi test local, không dùng cùng webhook
ZALO_BOT_POLL_TIMEOUT_SECONDS=25
ZALO_BOT_PROCESSED_MESSAGE_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 8. AI HOOK LOGGING — Nộp log cho giảng viên (AI20K Deliverable #4)
# ------------------------------------------------------------------------------
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key-here
AI_LOG_DIR=.ai-log
