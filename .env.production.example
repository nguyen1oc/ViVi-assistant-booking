# Copy to .env.production on the deployment host. Do not commit .env.production.
# GCP backend: the 39 variables below match the deployment configuration.
# Fill blank values on the deployment host; never put real secrets in this example.
# Secret, database, CORS, and provider values must be supplied before deployment.

APP_ENV=production
# Use two different random secrets, each at least 32 characters.
BOOKING_ACCESS_OTP_SECRET=
CONVERSATION_SIGNING_SECRET=
DATABASE_URL=
REDIS_URL=
REDIS_ENABLED=true
CORS_ORIGINS=
OPENAI_API_KEY=
MODEL_NAME=gpt-5.6-luna
CLASSIFIER_MODEL_NAME=gpt-4o-mini
BOOKING_ACCESS_OTP_TTL_SECONDS=300
BOOKING_ACCESS_OTP_RESEND_COOLDOWN_SECONDS=60
BOOKING_ACCESS_OTP_MAX_ATTEMPTS=3
INTERNAL_SESSION_TTL_SECONDS=28800
GUARDRAILS_ENABLED=true
RATE_LIMIT_ENABLED=true
LLM_DAILY_BUDGET_ENABLED=true
LLM_DAILY_MAX_COST_USD=20.0
LLM_SESSION_MAX_COST_USD_PER_DAY=1.0
# Gmail is enabled: all three OAuth credentials below must be filled.
GMAIL_ENABLED=true
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=vinfastlaithu@gmail.com
GMAIL_SENDER_NAME=VinFast
GMAIL_TIMEOUT_SECONDS=15
NOTIFICATION_POLL_INTERVAL_SECONDS=5
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=30
LLM_MAX_CALLS_PER_TURN=8
# Deployment estimates for budget accounting, not verified model pricing.
LLM_ESTIMATED_INPUT_TOKEN_PRICE_PER_1M=0.15
LLM_ESTIMATED_OUTPUT_TOKEN_PRICE_PER_1M=0.60
LLM_ESTIMATED_OUTPUT_TOKENS_PER_CALL=700
MEDIA_BASE_URL=
# Only needed by deployment/upload tooling that uses the Cloudflare API.
CLOUDFLARE_API_TOKEN=
# Opt-in simulation also works in production; real bookings still require OTP.
FLOATING_DEMO_ENABLED=true
LANGSMITH_TRACING=true
LANGSMITH_EVENT_LOGS=true
LANGSMITH_API_KEY=

# Additional existing production settings.
PUBLIC_SITE_URL=https://app.example.com
GUARDRAILS_ABUSE_MAX_STRIKES=3
GUARDRAILS_ABUSE_STRIKE_WINDOW_SECONDS=3600
GUARDRAILS_ABUSE_BAN_SECONDS=86400
BOOKING_ACCESS_EXPOSE_MOCK_OTP=false
OPENROUTER_API_KEY=
ZALO_BOT_TOKEN=
ZALO_BOT_ENABLED=false
ZALO_BOT_POLLING_ENABLED=false
# Public API and booking-access rate limits
RATE_LIMIT_CHAT_PER_SESSION_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_SESSION_PER_HOUR=120
RATE_LIMIT_CHAT_PER_IP_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_IP_PER_HOUR=600
RATE_LIMIT_DEMO_ACTION_PER_SESSION_PER_MINUTE=30
RATE_LIMIT_DEMO_ACTION_PER_SESSION_PER_HOUR=300
RATE_LIMIT_DEMO_ACTION_PER_IP_PER_MINUTE=120
RATE_LIMIT_DEMO_ACTION_PER_IP_PER_HOUR=1200
RATE_LIMIT_OTP_REQUEST_PER_CONTACT_PER_HOUR=10
RATE_LIMIT_OTP_VERIFY_PER_CHALLENGE_PER_MINUTE=5

# Docker Compose only: not required for a GCP backend using managed PostgreSQL.
POSTGRES_DB=vinfast_booking
POSTGRES_USER=vinfast
POSTGRES_PASSWORD=replace-with-a-long-random-secret
# Use immutable tags created by CI for a production deployment.
BACKEND_IMAGE=vinfast-backend:prod
FRONTEND_IMAGE=vinfast-frontend:prod
